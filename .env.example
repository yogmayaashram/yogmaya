# Public site configuration (use real project values; never commit .env.local)
NEXT_PUBLIC_SITE_URL=https://yogmaya.net
NEXT_PUBLIC_SANITY_PROJECT_ID=replace_with_real_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Optional YouTube Live video ID (11-character ID, not the full URL)
NEXT_PUBLIC_YOUTUBE_LIVE_VIDEO_ID=

# Supabase public browser configuration (anon/publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets: set in hosting dashboard, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER_KEY_ID=
PAYMENT_PROVIDER_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
EMAIL_PROVIDER_API_KEY=

# Auth callback must be added to Supabase Auth redirect allow-list
# Example local callback: http://localhost:3000/auth/callback

# Optional payment/meeting providers are NOT enabled until server routes and credentials are configured.
